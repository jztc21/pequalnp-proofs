theorem PEqualNP.Outside.R_meta_4305_412
    (h1 : ∀ (N s : ℕ) (W : ℕ → Set ((Fin N → Bool) × (Fin N → Bool))), (∀ (i : Fin N), W ↑i = {x : (Fin N → Bool) × (Fin N → Bool) | x.1 i = Bool.true} ∧ W (N + ↑i) = {x : (Fin N → Bool) × (Fin N → Bool) | x.2 i = Bool.true}) → (∀ k < s, ∃ (j1 : ℕ) (j2 : ℕ), Max.max j1 j2 < N + N + k ∧ (W (N + N + k) = W j1 ∪ W j2 ∨ W (N + N + k) = W j1 ∩ W j2)) → ∀ k < N + N + s, ∀ (a b a' b' : Fin N → Bool), (a, b) ∈ W k → (∀ (i : Fin N), a i = Bool.true → a' i = Bool.true) → (∀ (i : Fin N), b i = Bool.true → b' i = Bool.true) → (a', b') ∈ W k)
    (h2 : ∀ (q N : ℕ) (I : Fin N → Fin N → Prop) [DecidableRel I] (O : Set ((Fin N → Bool) × (Fin N → Bool))), 1 ≤ q → (∀ (p p' : Fin N), p ≠ p' → ∃! l : Fin N, I p l ∧ I p' l) → (∀ (a b a' b' : Fin N → Bool), (a, b) ∈ O → (∀ (i : Fin N), a i = Bool.true → a' i = Bool.true) → (∀ (i : Fin N), b i = Bool.true → b' i = Bool.true) → (a', b') ∈ O) → (∀ (y : Fin N → Bool), Fintype.card { l : Fin N // y l = Bool.true } ≤ q → (fun (p : Fin N) => Decidable.decide ¬∃ (l : Fin N), I p l ∧ y l = Bool.true, y) ∉ O) → ∀ (A B : Set (Fin N → Bool)), A ×ˢ B ⊆ O → ∀ (p l p' l' : Fin N), (fun (j : Fin N) => Decidable.decide (j = p)) ∈ A → (fun (j : Fin N) => Decidable.decide (j = l)) ∈ B → (fun (j : Fin N) => Decidable.decide (j = p')) ∈ A → (fun (j : Fin N) => Decidable.decide (j = l')) ∈ B → p = p' ∨ l = l')
    (h3 : ∀ (x1 x2 : ℕ) (x3 : Fin x2 → Fin x2 → Prop) [x4 : DecidableRel x3],   let x5 : Type := Fin x2 → Bool;   have x6 : ℕ := x2 + x2;   have x7 : Fin x2 → Fin x2 → Bool := fun (x7 x8 : Fin x2) => Decidable.decide (x8 = x7);   (100 : ℕ) < x1 → x2 = x1 ^ (2 : ℕ) + x1 + (1 : ℕ) → (∀ (x10 : Fin x2), Fintype.card { x11 : Fin x2 // x3 x11 x10 } = x1 + (1 : ℕ)) → (∀ (x11 x12 : Fin x2), x11 ≠ x12 → ∃! x14 : Fin x2, x3 x11 x14 ∧ x3 x12 x14) → ∀ (x12 x13 : ℕ) (x14 : ℕ → Set (x5 × x5)), x13 < x6 + x12 → (∀ (x16 : ℕ), x14 x16 ≠ ∅) → (∀ (x17 : Fin x2), x14 ↑x17 = {x18 : x5 × x5 | x18.1 x17 = Bool.true} ∧ x14 (x2 + ↑x17) = {x18 : x5 × x5 | x18.2 x17 = Bool.true}) → (∀ x18 < x12, ∃ (x20 : ℕ) (x21 : ℕ), Max.max x20 x21 < x6 + x18 ∧ (x14 (x6 + x18) = x14 x20 ∪ x14 x21 ∨ x14 (x6 + x18) = x14 x20 ∩ x14 x21)) → (∀ (x19 x20 : Fin x2), x3 x19 x20 → (x7 x19, x7 x20) ∈ x14 x13) → (∀ (x20 : x5), Fintype.card { x21 : Fin x2 // x20 x21 = Bool.true } ≤ x1 → (fun (x22 : Fin x2) => Decidable.decide ¬∃ (x23 : Fin x2), x3 x22 x23 ∧ x20 x23 = Bool.true, x20) ∉ x14 x13) → {x21 : Fin x2 × Fin x2 | x3 x21.1 x21.2 ∧ ∃ x22 < x12, x14 (x6 + x22) ⊆ x14 x13 ∧ (x7 x21.1, x7 x21.2) ∈ x14 (x6 + x22) ∧ ∃ (x23 : ℕ) (x24 : ℕ), Max.max x23 x24 < x6 + x22 ∧ x14 (x6 + x22) = x14 x23 ∩ x14 x24 ∧ ∃ (x25 : Set x5) (x26 : Set x5), x14 x23 = x25 ×ˢ Set.univ ∧ x14 x24 = Set.univ ×ˢ x26}.ncard ≤ (4 : ℕ) * x12 → (∀ k < x6 + x12, ∀ (a b a' b' : x5), (a, b) ∈ x14 k → (∀ (i : Fin x2), a i = Bool.true → a' i = Bool.true) → (∀ (i : Fin x2), b i = Bool.true → b' i = Bool.true) → (a', b') ∈ x14 k) → (∀ (A B : Set x5), A ×ˢ B ⊆ x14 x13 → ∀ (p l p' l' : Fin x2), x7 p ∈ A → x7 l ∈ B → x7 p' ∈ A → x7 l' ∈ B → p = p' ∨ l = l') → x2 * x1 ≤ (100 : ℕ) * x12) :
    ∀ (x1 x2 : ℕ) (x3 : Fin x2 → Fin x2 → Prop) [x4 : DecidableRel x3],   let x5 : Type := Fin x2 → Bool;   have x6 : ℕ := x2 + x2;   have x7 : Fin x2 → Fin x2 → Bool := fun (x7 x8 : Fin x2) => Decidable.decide (x8 = x7);   (100 : ℕ) < x1 → x2 = x1 ^ (2 : ℕ) + x1 + (1 : ℕ) → (∀ (x10 : Fin x2), Fintype.card { x11 : Fin x2 // x3 x11 x10 } = x1 + (1 : ℕ)) → (∀ (x11 x12 : Fin x2), x11 ≠ x12 → ∃! x14 : Fin x2, x3 x11 x14 ∧ x3 x12 x14) → ∀ (x12 x13 : ℕ) (x14 : ℕ → Set (x5 × x5)), x13 < x6 + x12 → (∀ (x16 : ℕ), x14 x16 ≠ ∅) → (∀ (x17 : Fin x2), x14 ↑x17 = {x18 : x5 × x5 | x18.1 x17 = Bool.true} ∧ x14 (x2 + ↑x17) = {x18 : x5 × x5 | x18.2 x17 = Bool.true}) → (∀ x18 < x12, ∃ (x20 : ℕ) (x21 : ℕ), Max.max x20 x21 < x6 + x18 ∧ (x14 (x6 + x18) = x14 x20 ∪ x14 x21 ∨ x14 (x6 + x18) = x14 x20 ∩ x14 x21)) → (∀ (x19 x20 : Fin x2), x3 x19 x20 → (x7 x19, x7 x20) ∈ x14 x13) → (∀ (x20 : x5), Fintype.card { x21 : Fin x2 // x20 x21 = Bool.true } ≤ x1 → (fun (x22 : Fin x2) => Decidable.decide ¬∃ (x23 : Fin x2), x3 x22 x23 ∧ x20 x23 = Bool.true, x20) ∉ x14 x13) → {x21 : Fin x2 × Fin x2 | x3 x21.1 x21.2 ∧ ∃ x22 < x12, x14 (x6 + x22) ⊆ x14 x13 ∧ (x7 x21.1, x7 x21.2) ∈ x14 (x6 + x22) ∧ ∃ (x23 : ℕ) (x24 : ℕ), Max.max x23 x24 < x6 + x22 ∧ x14 (x6 + x22) = x14 x23 ∩ x14 x24 ∧ ∃ (x25 : Set x5) (x26 : Set x5), x14 x23 = x25 ×ˢ Set.univ ∧ x14 x24 = Set.univ ×ˢ x26}.ncard ≤ (4 : ℕ) * x12 → x2 * x1 ≤ (100 : ℕ) * x12 :=
